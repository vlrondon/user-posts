# Copia este archivo como `.env` para cambiar la configuración local.
# Vite solo expone al navegador las variables que empiezan por VITE_:
# no pongas aquí secretos.

# URL base de la API. Si se omite, se usa https://jsonplaceholder.typicode.com
VITE_API_BASE_URL=https://jsonplaceholder.typicode.com
